# Tickless idle. Flash size and PSRAM: sdkconfig.defaults.esp32s3
# After changing this file: pio run -t fullclean then pio run -j 2

CONFIG_FREERTOS_USE_TICKLESS_IDLE=y
CONFIG_LWIP_TCPIP_TASK_AFFINITY_CPU0=y

CONFIG_PM_ENABLE=y
CONFIG_PM_PROFILING=y
# USB host holds NO_LIGHT_SLEEP. Unplug USB-C without header 5 V / hub = reset.
CONFIG_USJ_NO_AUTO_LS_ON_CONNECTION=y
